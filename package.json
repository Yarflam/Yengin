{
    "name": "yengin",
    "version": "3.0.0",
    "description": "Modern JavaScript library for Canvas, Math, Colors, and utilities - compatible with React, Vue, Angular",
    "main": "src/index.mjs",
    "type": "module",
    "exports": {
        ".": "./src/index.mjs",
        "./utils": "./src/utils/index.mjs",
        "./math": "./src/math/index.mjs",
        "./color": "./src/color/index.mjs",
        "./canvas": "./src/canvas/index.mjs",
        "./storage": "./src/storage/index.mjs",
        "./http": "./src/http/index.mjs"
    },
    "scripts": {
        "lint": "eslint src/**/*.mjs",
        "lint:fix": "eslint src/**/*.mjs --fix",
        "format": "prettier --write \"src/**/*.mjs\"",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Yarflam/Yengin.git"
    },
    "keywords": [
        "canvas",
        "math",
        "vector",
        "complex",
        "quaternion",
        "color",
        "utilities",
        "react",
        "vue",
        "angular",
        "framework-agnostic",
        "es6",
        "modules"
    ],
    "author": "Yarflam",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Yarflam/Yengin/issues"
    },
    "homepage": "https://github.com/Yarflam/Yengin#readme",
    "devDependencies": {
        "eslint": "^8.23.0",
        "jest": "^29.7.0",
        "prettier": "2.8.8"
    },
    "engines": {
        "node": "^14.15.0 || ^16.10.0 || >=18.0.0"
    }
}
